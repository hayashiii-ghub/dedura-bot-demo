{
  "name": "dedura-bot-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4181 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/state.test.ts",
    "test:browser": "bun run build && playwright test",
    "sync:ui": "bun scripts/sync-ui.ts"
  },
  "dependencies": {
    "@fontsource/yusei-magic": "^5.2.0",
    "@fontsource/zen-maru-gothic": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
